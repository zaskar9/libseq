load TTSSEQ30.DLL -> ok
SEQWIRE(0001) -> 0001
SEQOPEN(0000,0000) -> 0000
== open twice: the second SeqClose closes the port
SEQCREATESEQ(0000,0000) -> 0001
SEQOPEN(0000,0000) -> 0000
SEQCLOSE() -> 0001
SEQTXMIDIMSG(0000,0000,0090,003c,0040) -> 0001
SEQCREATESEQ(0000,0000) -> 0001
SEQCLOSE() -> 0001
SEQTXMIDIMSG(0000,0000,0090,003d,0040) -> 0001
SEQCREATESEQ(0000,0000) -> 0001
== a third SeqClose counts too: the next SeqOpen opens nothing, the one after does
SEQCLOSE() -> 0001
SEQOPEN(0000,0000) -> 0000
SEQTXMIDIMSG(0000,0000,0090,003e,0040) -> 0001
SEQOPEN(0000,0000) -> 0000
SEQTXMIDIMSG(0000,0000,0090,0046,0040) -> 0001
== SeqWire while open
SEQWIRE(0000) -> 0000
SEQTXMIDIMSG(0000,0000,0090,003f,0040) -> 0001
SEQWIRE(0001) -> 0001
SEQWIRE(0002) -> 0000
SEQWIRE(ffff) -> 0001
SEQTXMIDIMSG(0000,0000,0090,0040,0040) -> 0001
== sleep: the port closes; wake: it opens again
SEQSLEEP() -> 0000
SEQTXMIDIMSG(0000,0000,0090,0041,0040) -> 0001
SEQSLEEP() -> 0001
SEQWAKE() -> 0000
SEQTXMIDIMSG(0000,0000,0090,0042,0040) -> 0001
SEQWAKE() -> 0002
== not while playing
SEQLOADCAKEWALKFILE("C:\PROBE\ORC\E2_OVLP.WRK",0000) -> 0001
SEQSETPLAYINGSEQ(%1) -> 0001
SEQSTART(null,0000,0000) -> 0001
SEQSLEEP() -> 0003
SEQGETNOW(%1) -> 000000f0
SEQSTOP() -> 0001
== a start while asleep waits for the wake
SEQSETNOW(%1,d:00000000) -> 00000000
SEQSLEEP() -> 0000
SEQSTART(null,0000,0000) -> 0001
SEQEXPIRED() -> 0000
SEQGETNOW(%1) -> 00000000
SEQWAKE() -> 0000
SEQGETNOW(%1) -> 0000003c
SEQSTOP() -> 0001
== after such a wake the clock runs at 100 bpm until the next tempo change (at tick 480)
SEQLOADCAKEWALKFILE("C:\PROBE\ORC\ENG_TMPO.WRK",0000) -> 0002
SEQSETPLAYINGSEQ(%2) -> 0001
SEQSETNOW(%2,d:00000168) -> 00000168
SEQSLEEP() -> 0000
SEQSTART(null,0000,0000) -> 0001
SEQWAKE() -> 0000
SEQGETNOW(%2) -> 000001a4
SEQGETNOW(%2) -> 000001e0
SEQGETNOW(%2) -> 0000020d
SEQSTOP() -> 0001
SEQSETPLAYINGSEQ(%1) -> 0001
== not when opened twice
SEQOPEN(0000,0000) -> 0000
SEQSLEEP() -> 0002
SEQWAKE() -> 0002
SEQSTART(null,0000,0000) -> 0001
SEQSLEEP() -> 0002
SEQSTOP() -> 0001
SEQCLOSE() -> 0001
