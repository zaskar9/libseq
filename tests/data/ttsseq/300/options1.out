load TTSSEQ30.DLL -> ok
SEQWIRE(0001) -> 0001
SEQOPEN(0000,0000) -> 0000
== a new sequence
SEQCREATESEQ(0000,0000) -> 0001
SEQGETPPQ(0001) -> 0060
SEQSETSEQPARAM(0001,0007,d:00000000) -> 0001
SEQSETSEQPARAM(0001,0010,d:00000000) -> 0001
SEQSETSEQPARAM(0001,000e,d:00000000) -> 0001
== send a bank with one sysex message of 300 bytes
SEQCREATESYSXBANK(0001) -> 0100
SEQSYSXASC2BIN(%1,@1,@0) -> 0000
SEQGETSYSXBANKLEN(%1) -> 0000012c
SEQSENDSYSXBANK(%1,0000,0000) -> 0001
== receive two messages of 101 bytes (2000 and 2400 ms)
SEQCREATESYSXBANK(0001) -> 0101
SEQRECEIVESYSXBANK(%2,cb4,0000,0000,0000) -> 0001
callback cb4(----,----,----,----), repeated
SEQGETSYSXBANKLEN(%2) -> 000000ca
SEQSYSXBIN2ASC(%2,@1,0020) -> 00ca
dump 1+0:
  46 30 20 37 44 20 31 30 20 31 30 20 31 30 20 31
  30 20 31 30 20 31 30 20 31 30 20 31 30 20 31 30
  20 31 30 20 31 30 20 31 30 20 31 30 20 31 30 20
  31 30 20 31 30 20 31 30 20 31 30 20 31 30 20 31
  30 20 31 30 20 31 30 20 31 30 20 31 30 20 31 30
  20 31 30 20 31 30 20 31 30 20 31 30 20 31 30 20
  0d 0a 31 30 20 37 46 20 31 30 20 31 30 20 31 30
  20 31 30 20 31 30 20 31 30 20 31 30 20 31 30 20
  31 30 20 31 30 20 31 30 20 31 30 20 31 30 20 31
  30 20 31 30 20 31 30 20 31 30 20 31 30 20 31 30
  20 31 30 20 31 30 20 31 30 20 31 30 20 31 30 20
  31 30 20 31 30 20 31 30 20 31 30 20 31 30 20 31
  30 20 0d 0a 31 30 20 31 30 20 31 30 20 31 30 20
  31 30 20 31 30 20 31 30 20 31 30 20 31 30 20 31
  30 20 31 30 20 31 30 20 31 30 20 31 30 20 31 30
  20 31 30 20 31 30 20 31 30 20 31 30 20 31 30 20
  31 30 20 31 30 20 31 30 20 31 30 20 31 30 20 31
  30 20 31 30 20 31 30 20 31 30 20 31 30 20 31 30
  20 31 30 20 0d 0a 31 30 20 31 30 20 31 30 20 31
  30 20 46 37 20 46 30 20 37 44 20 30 30 20 30 31
  20 30 32 20 30 33 20 30 34 20
== record 1100 notes (4000 to 6200 ms)
SEQSETPLAYINGSEQ(0001) -> 0001
SEQSETSTANDBYSEQ(0000) -> 0001
SEQRECORD(0001) -> 0367
SEQSTART(cb3,0000,0000) -> 0001
SEQGETRECORDBUFFER() -> 0100
SEQSETRECORDBUFFERPARAMS(0000,0000,0000) -> 0000
SEQGETRECORDBUFFER() -> 0100
SEQRECORD(0000) -> 0001
SEQSTOP() -> 0001
SEQSTREAMLEN(0100) -> 00000400
== play E2_OVLP (overlapping notes)
SEQLOADCAKEWALKFILE("C:\PROBE\ORC\E2_OVLP.WRK",0000) -> 0002
SEQSETPLAYINGSEQ(0002) -> 0001
SEQSETSTANDBYSEQ(0000) -> 0001
SEQSTART(null,0000,0000) -> 0001
SEQSTOP() -> 0001
== MIDI Time Code from 00:00:10:00 (11500 to 15000 ms)
SEQSETSRCCLOCK(0002,0003) -> 0001
SEQSETPLAYINGSEQ(0002) -> 0001
SEQSTART(null,@0) -> 0001
SEQGETNOW(0002) -> 00000a14
dump 0+0:
  14 0a 00 00
SEQIDLE() -> 0001
SEQGETNOW(0002) -> 00000cc1
SEQEXPIRED() -> 0001
SEQCLOSE() -> 0001
