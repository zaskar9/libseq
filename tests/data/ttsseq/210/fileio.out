callback cb4(0008,----,----,1234) {
  SEQIOSEEK(%w1,d:00000000,0001) -> 00000333
  SEQIOREAD(%w1,@1,0004) -> 0004
  SEQIOREAD(%w1,@1+4,0002) -> 0002
  SEQIOREAD(%w1,@1+6,%b1+4) -> 0052
  dump 1+0:
  54 00 00 00 52 00 4c 69 6e 65 20 6f 6e 65 20 6f
  66 20 74 68 65 20 63 6f 6d 6d 65 6e 74 73 2e 0a
  4c 69 6e 65 20 74 77 6f 2c 20 77 69 74 68 20 61
  20 74 61 62 09 68 65 72 65 2e 0a 0a 4c 61 73 74
  20 6c 69 6e 65 20 61 66 74 65 72 20 61 20 62 6c
  61 6e 6b 20 6f 6e 65 2e ee ee ee ee ee ee ee ee
} -> 1
