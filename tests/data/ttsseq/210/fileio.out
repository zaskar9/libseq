load TTSSEQ.DLL -> ok
SEQWIRE(0001) -> 0000
SEQOPEN(0000,0000) -> 0000
== load SYN_MAPS: seek at the start, read the comments chunk (8) and take it
SEQLOADCAKEWALKFILE("C:\PROBE\ORC\SYN_MAPS.WRK",0000,cb4,d:00001234) ...
callback cb4(00fe,----,----,1234) {
  SEQIOSEEK(%w1,d:00000000,0001) -> 0000000b
  SEQIOSEEK(%w1,d:00000000,0002) -> 0000038c
  SEQIOSEEK(%w1,d:0000000b,0000) -> 0000000b
} -> 0
