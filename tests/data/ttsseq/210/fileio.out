callback cb4(00ff,----,----,1234)
SEQGETMETERMAPLEN(0001) -> 0006
== save it with a comments chunk of its own, written at the end (0xFF)
SEQSAVECAKEWALKFILE(0001,"C:\PROBE\ORC\OUT\IOSAVE.WRK",d:00000000,cb4,d:00005678) ...
callback cb4(00fe,----,----,5678)
callback cb4(0003,----,----,5678)
callback cb4(00fe,----,----,5678)
callback cb4(00ff,----,----,5678) {
  SEQIOSEEK(%w1,d:00000000,0001) -> 00000317
  SEQIOWRITE(%w1,@2,0001) -> 0001
  SEQIOWRITE(%w1,@2+1,0004) -> 0004
  SEQIOWRITE(%w1,@3,0002) -> 0002
  SEQIOWRITE(%w1,@1,0047) -> 0047
  SEQIOSEEK(%w1,d:00000000,0001) -> 00000365
} -> 1
SEQSAVECAKEWALKFILE(...) -> 0001
SEQDESTROYSEQ(0001) -> 0001
