load TTSSEQ.DLL -> ok
SEQWIRE(0001) -> 0000
SEQOPEN(0000,0000) -> 0000
== no sequence yet
== the first sequence, no playing sequence set
SEQCREATESEQ(0000,0000) -> 0001
SEQCREATESEQ(0000,0000) -> 0002
SEQSETSEQPARAM(0001,0009,d:00000003) -> 0001
SEQSETSEQPARAM(0002,0009,d:00000007) -> 0001
== playing sequence 2 (thru channel 7)
SEQSETPLAYINGSEQ(0002) -> 0001
== playing sequence 1 (thru channel 3)
SEQSETPLAYINGSEQ(0001) -> 0001
== standby sequence 2: no change
SEQSETSTANDBYSEQ(0002) -> 0001
== mode 1 (manual)
SEQSETSEQPARAM(0001,0007,d:00000001) -> 0001
== mode 0: nothing
SEQSETSEQPARAM(0001,0007,d:00000000) -> 0001
== mode 2, Key+ 100 and Vel+ 100: the top octave, velocity 127
SEQSETSEQPARAM(0001,0007,d:00000002) -> 0001
SEQSETSEQPARAM(0001,000a,d:00000064) -> 0001
SEQSETSEQPARAM(0001,000b,d:00000064) -> 0001
== Key+ -100 and Vel+ -120: folded up by octaves, velocity 1
SEQSETSEQPARAM(0001,000a,d:ffffff9c) -> 0001
SEQSETSEQPARAM(0001,000b,d:ffffff88) -> 0001
== channel 16: ORed into the status (a program change becomes channel pressure, the wheel goes)
SEQSETSEQPARAM(0001,000a,d:00000000) -> 0001
SEQSETSEQPARAM(0001,000b,d:00000000) -> 0001
SEQSETSEQPARAM(0001,0009,d:00000010) -> 0001
== channel -1, port 1: no such port
SEQSETSEQPARAM(0001,0009,d:ffffffff) -> 0001
SEQSETSEQPARAM(0001,0008,d:00000001) -> 0001
== port 0, record filter 0, Local On port 0: no change
SEQSETSEQPARAM(0001,0008,d:00000000) -> 0001
SEQSETSEQPARAM(0001,001c,d:00000000) -> 0001
SEQSETSEQPARAM(0001,000c,d:00000000) -> 0001
== a note held into the next slot
== channel 5: the held note's note off goes to channel 5, where it is not on, and is dropped
SEQSETSEQPARAM(0001,0009,d:00000005) -> 0001
== Local On port 0 and input on channel 5, the thru channel
== Local On port 0, channel -1
SEQSETSEQPARAM(0001,0009,d:ffffffff) -> 0001
== Local On port 1, channel -1
SEQSETSEQPARAM(0001,000c,d:00000001) -> 0001
== Local On port -1, channel 5
SEQSETSEQPARAM(0001,000c,d:ffffffff) -> 0001
SEQSETSEQPARAM(0001,0009,d:00000005) -> 0001
== SeqTxMidiMsg and the thru share the notes: the input ends a note SeqTxMidiMsg started
SEQTXMIDIMSG(0000,0005,0090,0030,0050) -> 0001
== and SeqTxMidiMsg ends a note the input started; the input's note off is dropped
SEQTXMIDIMSG(0000,0005,0080,0031,0000) -> 0001
== no playing sequence: nothing
SEQSETPLAYINGSEQ(0000) -> 0001
== the playing sequence destroyed: its settings stay
SEQSETPLAYINGSEQ(0001) -> 0001
SEQDESTROYSEQ(0001) -> 0001
== a new sequence becomes the current one, but the thru keeps the settings
SEQCREATESEQ(0000,0000) -> 0001
== until one of them is set on it
SEQSETSEQPARAM(0001,000a,d:00000001) -> 0001
== stopping the playback ends the notes SeqTxMidiMsg started too
SEQTXMIDIMSG(0000,000f,0090,003c,0050) -> 0001
SEQTXMIDIMSG(0000,0000,0090,007c,0050) -> 0001
SEQLOADCAKEWALKFILE("C:\PROBE\ORC\ENG_ORDR.WRK",0000,null,0000,0000) -> 0003
SEQSETPLAYINGSEQ(%1) -> 0001
SEQPLAYSTART(null) -> 0001
SEQPLAYSTOP() -> 0001
SEQCLOSE() -> 0001
