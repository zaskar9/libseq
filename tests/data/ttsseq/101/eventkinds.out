callback cb4(0004,----,----,0007) {
  dump w1+0:
  00 00 00 01 00 00 00 00
  SEQIOREAD(%1,@1,0004) -> 0004
  SEQIOREAD(%1,@1+4,%b1+0) -> 000d
  dump 1+0:
  0d 00 00 00 74 65 78 74 20 61 74 20 73 74 61 72
  74 ee ee ee ee ee ee ee ee ee ee ee ee ee ee ee
} -> 1
callback cb4(0004,----,----,0007) {
  dump w1+0:
  00 00 00 02 00 00 00 00
  SEQIOREAD(%1,@1,0004) -> 0004
  SEQIOREAD(%1,@1+4,%b1+0) -> 0018
  dump 1+0:
  18 00 00 00 70 6c 61 79 20 63 3a 5c 73 6f 75 6e
  64 73 5c 68 65 6c 6c 6f 2e 77 61 76 ee ee ee ee
} -> 1
callback cb4(0004,----,----,0007) {
  dump w1+0:
  e0 01 00 01 00 00 00 00
  SEQIOREAD(%1,@1,0004) -> 0004
  SEQIOREAD(%1,@1+4,%b1+0) -> 000f
  dump 1+0:
  0f 00 00 00 74 65 78 74 20 61 74 20 74 68 65 20
  65 6e 64 ee ee ee ee ee ee ee ee ee ee ee ee ee
} -> 1
