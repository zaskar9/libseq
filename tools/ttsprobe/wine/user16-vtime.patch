+++ b/dlls/user.exe16/user.c
@@ -37,6 +37,29 @@
 
 WINE_DEFAULT_DEBUG_CHANNEL(user);
 
+/***********************************************************************
+ *		GetTickCount (USER.13), GetCurrentTime (USER.15)
+ *
+ * With WINE_VTIME=1 the tick count comes from MMSYSTEM's virtual clock (VTIMETICKS,
+ * mmsystem16-vtime.patch), once that module is loaded.
+ */
+DWORD WINAPI GetTickCount16(void)
+{
+    static int vtime = -1;
+    static FARPROC16 ticks;
+    DWORD ret;
+
+    if (vtime < 0) vtime = getenv("WINE_VTIME") && atoi(getenv("WINE_VTIME")) != 0;
+    if (vtime && !ticks)
+    {
+        HMODULE16 mmsystem = GetModuleHandle16("MMSYSTEM");
+        if (mmsystem) ticks = GetProcAddress16(mmsystem, (LPCSTR)MAKEINTRESOURCE(2002));
+    }
+    if (!ticks) return GetTickCount();
+    WOWCallback16Ex((DWORD)ticks, WCB16_PASCAL, 0, NULL, &ret);
+    return ret;
+}
+
 /* handle to handle 16 conversions */
 #define HANDLE_16(h32)		(LOWORD(h32))
 #define HGDIOBJ_16(h32)		(LOWORD(h32))
