+/* WINE_WIN16_IRQ_CALLBACKS: callbacks at "interrupt time" (for observing 16-bit multimedia programs
+ * that wait in a loop for a timer or MIDI callback, as Windows 3.1 allows): set to anything, the
+ * callbacks of non-task threads run without the Win16 lock; set to "serial", they also run one at a
+ * time in the order they come, while the tasks' 16-bit code stands still, and 16-bit cli ... sti
+ * keeps them out, as disabling interrupts does. WINE_IRQ_TIMING=1 reports waits and holds. */
+static int irq_mode = -1;  /* 0 unset, 1 set, 2 "serial" */
+static int irq_timing;
+
+/**********************************************************************
+ *           irq_callback
+ *
+ * Whether a callback is run without the Win16 lock, as Windows 3.1 runs the callbacks of
+ * multimedia timers and drivers at interrupt time: only when WINE_WIN16_IRQ_CALLBACKS is set,
+ * and only on threads that are not Win16 tasks (the threads that deliver those callbacks).
+ */
+static BOOL irq_callback(void)
+{
+    if (irq_mode < 0)
+    {
+        char value[16];
+        DWORD len = GetEnvironmentVariableA( "WINE_WIN16_IRQ_CALLBACKS", value, sizeof(value) );
+        irq_timing = GetEnvironmentVariableA( "WINE_IRQ_TIMING", NULL, 0 ) != 0;
+        irq_mode = !len ? 0 : (len < sizeof(value) && !strcmp( value, "serial" )) ? 2 : 1;
+    }
+    return irq_mode && !kernel_get_thread_data()->htask16;
+}
+
+/* The "interrupt" lock: a ticket lock, so that callbacks and the tasks' cli are served in the order
+ * they ask (a critical section let a frequent timer callback starve the MIDI input callback). */
+static LONG irq_next, irq_serving;
+static DWORD irq_owner, irq_depth;
+
+static LONGLONG irq_now_us(void)
+{
+    LARGE_INTEGER c, f;
+    QueryPerformanceCounter( &c );
+    QueryPerformanceFrequency( &f );
+    return c.QuadPart * 1000000 / f.QuadPart;
+}
+
+static void irq_lock( const char *who )
+{
+    DWORD self = GetCurrentThreadId();
+    LONG ticket;
+    LONGLONG start = 0;
+
+    if (irq_owner == self) { irq_depth++; return; }
+    if (irq_timing) start = irq_now_us();
+    ticket = InterlockedIncrement( &irq_next ) - 1;
+    while (*(volatile LONG *)&irq_serving != ticket) Sleep( 0 );
+    irq_owner = self;
+    irq_depth = 1;
+    if (irq_timing && irq_now_us() - start >= 5000)
+        fprintf( stderr, "irq: %s %04lx waited %lu us\n", who, self, (ULONG)(irq_now_us() - start) );
+}
+
+static void irq_unlock(void)
+{
+    if (--irq_depth) return;
+    irq_owner = 0;
+    InterlockedIncrement( &irq_serving );
+}
+
+/* cli and sti of 16-bit code: with "serial" interrupt-time callbacks, cli keeps them out (takes their
+ * lock) until sti, as disabling interrupts does on Windows 3.1 */
+static DWORD cli_tls = TLS_OUT_OF_INDEXES;
+
+void WOWTHUNK_Cli(void)
+{
+    irq_callback();  /* reads the mode */
+    if (irq_mode != 2) return;
+    if (cli_tls == TLS_OUT_OF_INDEXES)
+    {
+        DWORD index = TlsAlloc();
+        if (InterlockedCompareExchange( (LONG *)&cli_tls, index, TLS_OUT_OF_INDEXES ) != TLS_OUT_OF_INDEXES) TlsFree( index );
+    }
+    if (TlsGetValue( cli_tls )) return;
+    irq_lock( "cli" );
+    TlsSetValue( cli_tls, (void *)1 );
+}
+
+void WOWTHUNK_Sti(void)
+{
+    if (irq_mode != 2 || cli_tls == TLS_OUT_OF_INDEXES || !TlsGetValue( cli_tls )) return;
+    TlsSetValue( cli_tls, NULL );
+    irq_unlock();
+}
+
+/* While a "serial" callback runs, the Win16 tasks that are in 16-bit code stand still, as a program
+ * does while an interrupt handler runs. A task in 32-bit code (inside Windows) goes on: stopping it
+ * there could stop it holding a lock the callback needs. Guarded by the interrupt lock. */
+static HANDLE frozen[16];
+static DWORD nfrozen;
+
+static void freeze_tasks(void)
+{
+    DWORD ids[16], n = TASK_GetTaskThreads( ids, 16 ), self = GetCurrentThreadId(), i;
+    CONTEXT ctx;
+    HANDLE h;
+
+    nfrozen = 0;
+    for (i = 0; i < n; i++)
+    {
+        if (ids[i] == self) continue;
+        if (!(h = OpenThread( THREAD_SUSPEND_RESUME | THREAD_GET_CONTEXT, FALSE, ids[i] ))) continue;
+        if (SuspendThread( h ) == (DWORD)-1) { CloseHandle( h ); continue; }
+        ctx.ContextFlags = CONTEXT_CONTROL;
+        if (GetThreadContext( h, &ctx ) && !ldt_is_system( ctx.SegCs ))
+        {
+            frozen[nfrozen++] = h;
+            continue;
+        }
+        ResumeThread( h );
+        CloseHandle( h );
+    }
+}
+
+static void thaw_tasks(void)
+{
+    while (nfrozen)
+    {
+        HANDLE h = frozen[--nfrozen];
+        ResumeThread( h );
+        CloseHandle( h );
+    }
+}
+
+/* the Win16 lock for an ordinary callback; for an interrupt-time one the interrupt lock, so that
+ * such callbacks run one at a time, as interrupt handlers do, but while a task holds the Win16 lock */
+static LONGLONG hold_start;
+
+static void enter_callback( BOOL irq )
+{
+    if (!irq) _EnterWin16Lock();
+    else if (irq_mode == 2)
+    {
+        irq_lock( "callback" );
+        if (irq_depth == 1)
+        {
+            freeze_tasks();
+            if (irq_timing) hold_start = irq_now_us();
+        }
+    }
+}
+
+static void leave_callback( BOOL irq )
+{
+    if (!irq) _LeaveWin16Lock();
+    else if (irq_mode == 2)
+    {
+        if (irq_depth == 1)
+        {
+            if (irq_timing && irq_now_us() - hold_start >= 5000)
+                fprintf( stderr, "irq: callback %04lx ran %lu us\n", GetCurrentThreadId(), (ULONG)(irq_now_us() - hold_start) );
+            thaw_tasks();
+        }
+        irq_unlock();
+    }
+}
