+/* WINE_WIN16_IRQ_CALLBACKS: callbacks at "interrupt time" (for observing 16-bit multimedia programs
+ * that wait in a loop for a timer or MIDI callback, as Windows 3.1 allows): set to anything, the
+ * callbacks of non-task threads run without the Win16 lock; set to "serial", they also run one at a
+ * time, and 16-bit cli ... sti keeps them out, as disabling interrupts does. */
+static CRITICAL_SECTION irq_section;
+static CRITICAL_SECTION_DEBUG irq_section_debug =
+{
+    0, 0, &irq_section,
+    { &irq_section_debug.ProcessLocksList, &irq_section_debug.ProcessLocksList },
+      0, 0, { (DWORD_PTR)(__FILE__ ": irq_section") }
+};
+static CRITICAL_SECTION irq_section = { &irq_section_debug, -1, 0, 0, 0, 0 };
+
+static int irq_mode = -1;  /* WINE_WIN16_IRQ_CALLBACKS: 0 unset, 1 set, 2 "serial" */
+
+/**********************************************************************
+ *           irq_callback
+ *
+ * Whether a callback is run without the Win16 lock, as Windows 3.1 runs the callbacks of
+ * multimedia timers and drivers at interrupt time: only when WINE_WIN16_IRQ_CALLBACKS is set,
+ * and only on threads that are not Win16 tasks (the threads that deliver those callbacks).
+ */
+static BOOL irq_callback(void)
+{
+    if (irq_mode < 0)
+    {
+        char value[16];
+        DWORD len = GetEnvironmentVariableA( "WINE_WIN16_IRQ_CALLBACKS", value, sizeof(value) );
+        irq_mode = !len ? 0 : (len < sizeof(value) && !strcmp( value, "serial" )) ? 2 : 1;
+    }
+    return irq_mode && !kernel_get_thread_data()->htask16;
+}
+
+/* cli and sti of 16-bit code: with "serial" interrupt-time callbacks, cli keeps them out (takes their
+ * lock) until sti, as disabling interrupts does on Windows 3.1 */
+static DWORD cli_tls = TLS_OUT_OF_INDEXES;
+
+void WOWTHUNK_Cli(void)
+{
+    irq_callback();  /* reads the mode */
+    if (irq_mode != 2) return;
+    if (cli_tls == TLS_OUT_OF_INDEXES)
+    {
+        DWORD index = TlsAlloc();
+        if (InterlockedCompareExchange( (LONG *)&cli_tls, index, TLS_OUT_OF_INDEXES ) != TLS_OUT_OF_INDEXES) TlsFree( index );
+    }
+    if (TlsGetValue( cli_tls )) return;
+    EnterCriticalSection( &irq_section );
+    TlsSetValue( cli_tls, (void *)1 );
+}
+
+void WOWTHUNK_Sti(void)
+{
+    if (irq_mode != 2 || cli_tls == TLS_OUT_OF_INDEXES || !TlsGetValue( cli_tls )) return;
+    TlsSetValue( cli_tls, NULL );
+    LeaveCriticalSection( &irq_section );
+}
+
+/* the Win16 lock for an ordinary callback; for an interrupt-time one a lock of its own, so that
+ * such callbacks run one at a time, as interrupt handlers do, but while a task holds the Win16 lock */
+static void enter_callback( BOOL irq )
+{
+    if (!irq) _EnterWin16Lock(); else if (irq_mode == 2) EnterCriticalSection( &irq_section );
+}
+
+static void leave_callback( BOOL irq )
+{
+    if (!irq) _LeaveWin16Lock(); else if (irq_mode == 2) LeaveCriticalSection( &irq_section );
+}
+
