+/***********************************************************************
+ *           TASK_GetTaskThreads
+ *
+ * The thread ids of the Win16 tasks, at most max of them.
+ */
+DWORD TASK_GetTaskThreads( DWORD *ids, DWORD max )
+{
+    DWORD n = 0;
+    TDB *p = TASK_GetPtr( hFirstTask );
+    while (p && n < max)
+    {
+        ids[n++] = HandleToULong( p->teb->ClientId.UniqueThread );
+        p = TASK_GetPtr( p->hNext );
+    }
+    return n;
+}
+
